# Copy to .env for local development.
# On Railway, set these as environment variables in the dashboard.

# DVLA Vehicle Enquiry Service API key
# Get free key at: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=your_dvla_api_key_here

# Database — on Railway this auto-resolves to /data/vehiclemarket.db (persistent volume)
# DATABASE_URL=sqlite+aiosqlite:////data/vehiclemarket.db

# Scraper settings
SCRAPE_INTERVAL_MINUTES=60
MAX_PAGES_PER_RUN=10
REQUEST_DELAY_SECONDS=3
HEADLESS=true

# API — Railway injects PORT automatically, no need to set API_PORT on Railway
API_HOST=0.0.0.0
SECRET_KEY=change-this-to-a-random-secret

# Alerts - optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
